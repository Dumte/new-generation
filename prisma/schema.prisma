// -------- ENUMS ---------
// Enu for sex since it will only be a male or female
enum UserSex {
  MALE
  FEMALE
}

// Enu for day since it will from Monday through Friday
enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}
